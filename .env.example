# Supabase
# URL and publishable key are safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service role key — SERVER ONLY. Never expose with NEXT_PUBLIC_ prefix.
# Used only for privileged server-side operations (e.g. admin utilities).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used for metadata/Open Graph/sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
